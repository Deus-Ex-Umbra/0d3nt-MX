DB_TYPE=postgres
# Opcion 1: usar la URL completa de PostgreSQL, por ejemplo la que entrega Supabase.
DATABASE_URL=

# Opcion 2: usar los campos por separado.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=db0d3ntnr
SSL_ENABLED=false
# En Supabase normalmente debes establecer SSL_ENABLED=true.
PORT=3000
# Ruta opcional al ejecutable de Chromium/Chrome para Puppeteer.
# Si no se define, Puppeteer intentará usar la instalación disponible en el sistema.
CHROMIUM_EXECUTABLE_PATH=
JWT_SECRET=
JWT_EXPIRATION_TIME=
ARCHIVOS_PATH=
BASE_URL=
IS_SERVERLESS=false
# Configuración de Almacenamiento (Local vs Nube)
CLOUD=false
# Variables de AWS S3 (Solo si CLOUD=true)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_CDN=

# VL0d3ntApp Backend (Licenciamiento)
# Base URL del backend que expone /api/cliente/* (ej: http://localhost:3001)
VL_API_BASE_URL=

# Llave pública Ed25519 del validador (para validar firmas offline en el cliente Electron).
# Formato PEM (spki). En .env suele venir con saltos escapados como \n.
# Nota: esta variable la lee el proceso Electron (main.js). Si prefieres, también puedes definirla en el .env raíz.
VL_ED25519_PUBLIC_KEY_PEM=

# Define si la aplicación requiere licencia (true por defecto). Si es false, se omite la validación de licencia.
LICENCIABLE=false
